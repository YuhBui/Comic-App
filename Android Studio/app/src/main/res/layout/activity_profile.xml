<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2A2A2A">

        <include
            android:id="@+id/layoutHeaderProfile"
            layout="@layout/layout_header"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <ProgressBar
            android:id="@+id/progressBarProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:elevation="20dp"
            android:progressTint="#FFB77D"
            android:secondaryProgressTint="#FFB77D"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/layoutHeaderProfile"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rank_item"
                    android:backgroundTint="#1E1E1E"
                    android:paddingTop="24dp"
                    android:paddingBottom="40dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="32dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/layoutChangeAvatar"
                            android:layout_width="128dp"
                            android:layout_height="128dp"
                            app:cardCornerRadius="64dp"
                            app:strokeColor="#D97707"
                            app:strokeWidth="2dp"
                            app:cardElevation="4dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/imgProfileAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/sym_def_app_icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvChangeAvatarText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Thay ảnh"
                            android:textColor="#FFB77D"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thông tin cá nhân"
                        android:textColor="#DBC2B0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#4D554326"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Họ và tên"
                        android:textColor="#DBC2B0"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:letterSpacing="0.05" />

                    <EditText
                        android:id="@+id/edtProfileFullName"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_nav_btn"
                        android:backgroundTint="#2A2A2A"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Manga Noir Admin"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="24dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="#DBC2B0"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:letterSpacing="0.05" />

                    <EditText
                        android:id="@+id/edtProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_nav_btn"
                        android:backgroundTint="#2A2A2A"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="admin@manganoir.com"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:inputType="textEmailAddress"
                        android:layout_marginBottom="32dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bảo mật"
                        android:textColor="#DBC2B0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:paddingBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#4D554326"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mật khẩu mới"
                        android:textColor="#DBC2B0"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:letterSpacing="0.05" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_nav_btn"
                        android:backgroundTint="#2A2A2A"
                        android:layout_marginBottom="24dp">
                        <EditText
                            android:id="@+id/edtProfileNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="16dp"
                            android:paddingEnd="48dp"
                            android:hint="Nhập mật khẩu mới"
                            android:textColorHint="#4DDBC2B0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:inputType="textPassword" />
                        <ImageView
                            android:id="@+id/btnToggleNewPassword"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="12dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="#DBC2B0" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Xác nhận mật khẩu mới"
                        android:textColor="#DBC2B0"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"
                        android:letterSpacing="0.05" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_nav_btn"
                        android:backgroundTint="#2A2A2A"
                        android:layout_marginBottom="32dp">
                        <EditText
                            android:id="@+id/edtProfileConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:paddingStart="16dp"
                            android:paddingEnd="48dp"
                            android:hint="Xác nhận mật khẩu mới"
                            android:textColorHint="#4DDBC2B0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:inputType="textPassword" />
                        <ImageView
                            android:id="@+id/btnToggleConfirmPassword"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="12dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="#DBC2B0" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="32dp"
                        android:background="@drawable/bg_top_line_border">

                        <Button
                            android:id="@+id/btnSaveProfile"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="LƯU THAY ĐỔI"
                            android:textColor="#4D2600"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:backgroundTint="#FFB77D"
                            android:layout_marginBottom="16dp"
                            app:cornerRadius="12dp" />

                        <Button
                            android:id="@+id/btnCancelProfile"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="HỦY"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:backgroundTint="#2A2A2A"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/drawerMenuContainer"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true" />

</androidx.drawerlayout.widget.DrawerLayout>