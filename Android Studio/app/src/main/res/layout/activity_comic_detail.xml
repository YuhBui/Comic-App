<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2A2A2A"
        android:orientation="vertical">

        <include
            android:id="@+id/layoutHeader"
            layout="@layout/layout_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="afterDescendants"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="105dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <androidx.cardview.widget.CardView
                        android:layout_width="119dp"
                        android:layout_height="179dp"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#1E1E1E">
                        <ImageView
                            android:id="@+id/imgComicCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#2E3545"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvComicTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvComicAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tác giả: Hara Yasuhisa"
                            android:textColor="#DBC2B0"
                            android:alpha="0.7"
                            android:textSize="12sp"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tvComicGenre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thể loại: Action, Adventure"
                            android:textColor="#DBC2B0"
                            android:alpha="0.7"
                            android:textSize="12sp"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tvComicRelease"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Phát hành: --"
                            android:textColor="#DBC2B0"
                            android:alpha="0.7"
                            android:textSize="12sp"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tvComicStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tình trạng: Ongoing"
                            android:textColor="#DBC2B0"
                            android:alpha="0.7"
                            android:textSize="12sp"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tvComicViews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lượt xem: 1.2M"
                            android:textColor="#DBC2B0"
                            android:alpha="0.7"
                            android:textSize="12sp"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tvComicFavorites"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Yêu thích: 45k"
                            android:textColor="#DBC2B0"
                            android:alpha="0.7"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đánh giá: "
                                android:textColor="#DBC2B0"
                                android:alpha="0.7"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvComicRatingAverage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.8"
                                android:textColor="#FFB77D"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginStart="2dp"
                                android:src="@android:drawable/btn_star_big_on"
                                app:tint="#FFB77D"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvComicDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Nội dung tóm tắt của truyện..."
                    android:textColor="#DBC2B0"
                    android:alpha="0.9"
                    android:textSize="14sp"
                    android:lineHeight="23dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnStartReading"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:backgroundTint="#D97707"
                        android:text="ĐỌC TỪ CHƯƠNG ĐẦU"
                        android:textColor="#432100"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="8dp"
                        app:strokeColor="#A38C7C"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/btnToggleFavorite"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_heart_outline"
                            app:tint="#FFB77D"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#1E1E1E"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:cornerRadius="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Danh sách chương"
                        android:textColor="#FFB77D"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewChapters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="280dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutUserRatingBox"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:background="#1E1E1E"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clipToPadding="false"
                    app:cornerRadius="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ĐÁNH GIÁ CỦA BẠN"
                        android:textColor="#DBC2B0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <RatingBar
                        android:id="@+id/ratingBarUser"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0"
                        android:stepSize="1.0"
                        android:progressTint="#FFB77D"
                        android:secondaryProgressTint="#2A2A2A"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCommentsMainBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#1E1E1E"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bình luận"
                        android:textColor="#FFB77D"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1A554326"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/layoutCommentInputArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#2A2A2A"
                        android:padding="4dp"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/edtCommentInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Viết bình luận..."
                            android:textColorHint="#80DBC2B0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:inputType="textShortMessage" />

                        <Button
                            android:id="@+id/btnSendComment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gửi"
                            android:textColor="#432100"
                            android:backgroundTint="#FFB77D"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <include layout="@layout/layout_side_menu" />

</androidx.drawerlayout.widget.DrawerLayout>