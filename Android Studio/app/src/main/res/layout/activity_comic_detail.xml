<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/layoutHeader"
        layout="@layout/layout_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:descendantFocusability="afterDescendants"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgComicCover"
                    android:layout_width="110dp"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvComicTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#000"/>

                    <TextView
                        android:id="@+id/tvComicAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tác giả: Đang cập nhật"
                        android:layout_marginTop="6dp"
                        android:textColor="#555555"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvComicGenre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thể loại: Đang cập nhật"
                        android:layout_marginTop="4dp"
                        android:textColor="#555555"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvComicRelease"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phát hành: --"
                        android:layout_marginTop="4dp"
                        android:textColor="#555555"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvComicStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tình trạng: Đang tiến hành"
                        android:layout_marginTop="4dp"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvComicViews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👁️ 0"
                            android:textSize="13sp"
                            android:textColor="#666666"/>

                        <View android:layout_width="14dp" android:layout_height="1dp"/>

                        <TextView
                            android:id="@+id/tvComicFavorites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❤️ 0"
                            android:textSize="13sp"
                            android:textColor="#E91E63"/>

                        <View android:layout_width="14dp" android:layout_height="1dp"/>

                        <TextView
                            android:id="@+id/tvComicRatingAverage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 0.0/5"
                            android:textSize="13sp"
                            android:textColor="#FF9800"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đánh giá của bạn: "
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textSize="14sp"/>

                    <RatingBar
                        android:id="@+id/ratingBarUser"
                        style="?android:attr/ratingBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0"
                        android:stepSize="1.0"
                        android:isIndicator="false"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mô tả nội dung:"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:textColor="#000000"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvComicDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nội dung tóm tắt của truyện..."
                    android:textColor="#333333"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnStartReading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📖 Đọc từ chương đầu"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnToggleFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="❤️ Yêu thích"
                    android:textColor="#FF5722"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:background="?android:attr/selectableItemBackground"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh sách chương:"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:textColor="#000"
                android:textSize="15sp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewChapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bình luận cộng đồng:"
                android:layout_marginTop="24dp"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <EditText
                    android:id="@+id/edtCommentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Viết bình luận..."
                    android:inputType="textShortMessage"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:enabled="true" />
                <Button
                    android:id="@+id/btnSendComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gửi"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>