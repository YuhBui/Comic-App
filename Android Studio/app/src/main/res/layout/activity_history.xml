<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#2A2A2A">

        <include
            android:id="@+id/layoutHeaderHistory"
            layout="@layout/layout_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2A2A2A"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lịch sử đọc"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:letterSpacing="-0.02"/>

                    <ImageView
                        android:id="@+id/imgPageFilter"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_filter"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Bộ lọc thể loại"
                        app:tint="#DBC2B0" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnPrevPageHistory"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="&lt;"
                        android:textColor="#DBC2B0"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/bg_nav_btn"
                        android:backgroundTint="#1E1E1E"
                        android:padding="0dp"/>

                    <LinearLayout
                        android:id="@+id/layoutPageNumbersHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"/>

                    <Button
                        android:id="@+id/btnNextPageHistory"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="&gt;"
                        android:textColor="#DBC2B0"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/bg_nav_btn"
                        android:backgroundTint="#1E1E1E"
                        android:padding="0dp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <include layout="@layout/layout_side_menu" />

</androidx.drawerlayout.widget.DrawerLayout>