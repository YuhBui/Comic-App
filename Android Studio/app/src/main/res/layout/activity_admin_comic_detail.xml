<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2A2A2A"
        android:orientation="vertical">

        <include
            android:id="@+id/layoutHeaderAdminDetail"
            layout="@layout/layout_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E1E1E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBackComicDetail"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Chi tiết truyện"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4D554336" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="120dp"
                        android:layout_height="180dp"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#1E1E1E">

                        <ImageView
                            android:id="@+id/imgAdminDetailCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAdminDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tên Bộ Truyện Tranh"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvAdminDetailAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tác giả: Đang tải..."
                            android:textColor="#B3DBC2B0"
                            android:textSize="12sp"
                            android:letterSpacing="0.03"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvAdminDetailGenre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thể loại: Action, Adventure"
                            android:textColor="#B3DBC2B0"
                            android:textSize="12sp"
                            android:letterSpacing="0.03"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvAdminDetailRelease"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Phát hành: Updated 2 hours ago"
                            android:textColor="#B3DBC2B0"
                            android:textSize="12sp"
                            android:letterSpacing="0.03"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvAdminDetailStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tình trạng: Ongoing"
                            android:textColor="#B3DBC2B0"
                            android:textSize="12sp"
                            android:letterSpacing="0.03"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvAdminDetailViews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lượt xem: 0"
                            android:textColor="#B3DBC2B0"
                            android:textSize="12sp"
                            android:letterSpacing="0.03"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvAdminDetailFavorites"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Yêu thích: 0"
                            android:textColor="#B3DBC2B0"
                            android:textSize="12sp"
                            android:letterSpacing="0.03"
                            android:layout_marginBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đánh giá: "
                                android:textColor="#B3DBC2B0"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvAdminDetailRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFB77D"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="4dp"/>

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@android:drawable/btn_star_big_on"
                                app:tint="#FFB77D" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tóm tắt nội dung truyện"
                    android:textColor="#FFB77D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvAdminDetailDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nội dung tóm tắt bộ truyện..."
                    android:textColor="#E6DBC2B0"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/btnAdminEditComicDetail"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:backgroundTint="#D97707"
                        android:text="Cập nhật"
                        android:textColor="#432100"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnAdminDeleteComicDetail"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:backgroundTint="#93000A"
                        android:text="Xóa"
                        android:textColor="#FFDAD6"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E1E1E"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Danh sách chương"
                            android:textColor="#FFB77D"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnAdminAddChapter"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:backgroundTint="#33FFB77D"
                            android:text="Thêm chương mới"
                            android:textColor="#FFB77D"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="12dp"/>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="280dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAdminDetailChapters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="true" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E1E1E"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bình luận"
                        android:textColor="#FFB77D"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/edtAdminCommentInput"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="#2A2A2A"
                            android:hint="Viết bình luận Admin..."
                            android:textColorHint="#80DBC2B0"
                            android:textColor="#DCE2F7"
                            android:textSize="14sp"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/edtAdminCommentInput"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:background="#2A2A2A"
                                android:hint="Viết bình luận về bộ truyện này..."
                                android:textColorHint="#80DBC2B0"
                                android:textColor="#DCE2F7"
                                android:paddingHorizontal="12dp"
                                android:textSize="14sp"
                                android:singleLine="true"/>

                            <ImageButton
                                android:id="@+id/btnAdminSendComment"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="#FFB77D"
                                android:src="@android:drawable/ic_menu_send"
                                app:tint="#4D2600"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                android:contentDescription="Gửi bình luận" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminDetailComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <include layout="@layout/layout_admin_side_menu" />

</androidx.drawerlayout.widget.DrawerLayout>