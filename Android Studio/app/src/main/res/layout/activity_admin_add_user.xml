<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:orientation="vertical">

        <include
            android:id="@+id/layoutHeaderAddUser"
            layout="@layout/layout_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgAddUserSelectAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:background="#F0F0F0"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/sym_def_app_icon" />

                <Button
                    android:id="@+id/btnChooseAvatarAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="#2196F3"
                    android:padding="0dp"
                    android:text="Chọn ảnh đại diện"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edtAddUserName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="12dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Tên hiển thị người dùng"
                    android:paddingStart="12dp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtAddUserEmail"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="12dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="Địa chỉ Email đăng nhập"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#555555">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtAddUserPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nhập mật khẩu truy cập"
                        android:inputType="textPassword"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#555555">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtAddUserConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nhập lại mật khẩu để xác minh"
                        android:inputType="textPassword"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Phân quyền vai trò:"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerAddUserRole"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="28dp"
                    android:background="@android:drawable/btn_dropdown" />

                <Button
                    android:id="@+id/btnAdminAddUserSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#4CAF50"
                    android:text="TIẾN HÀNH TẠO THÀNH VIÊN"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>


    <include layout="@layout/layout_admin_side_menu" />

</androidx.drawerlayout.widget.DrawerLayout>