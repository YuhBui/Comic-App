<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <include android:id="@+id/layoutHeaderAddUser" layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/imgAddUserSelectAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@android:drawable/sym_def_app_icon"
                android:background="#F0F0F0"
                android:scaleType="centerCrop"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnChooseAvatarAdd"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Chọn ảnh đại diện"
                android:textSize="11sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"
                android:padding="0dp"/>

            <EditText
                android:id="@+id/edtAddUserName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="Tên hiển thị người dùng"
                android:background="@android:drawable/edit_text"
                android:paddingStart="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/edtAddUserEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="Địa chỉ Email đăng nhập"
                android:background="@android:drawable/edit_text"
                android:paddingStart="12dp"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#555555"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAddUserPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập mật khẩu truy cập"
                    android:textSize="14sp"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#555555"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAddUserConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập lại mật khẩu để xác minh"
                    android:textSize="14sp"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phân quyền vai trò:"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerAddUserRole"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="28dp"/>

            <Button
                android:id="@+id/btnAdminAddUserSubmit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="TIẾN HÀNH TẠO THÀNH VIÊN"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>