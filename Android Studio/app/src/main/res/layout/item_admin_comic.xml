<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAdminComicItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:background="#FFFFFF"
    android:elevation="1dp">

    <ImageView
        android:id="@+id/imgAdminComicCover"
        android:layout_width="70dp"
        android:layout_height="95dp"
        android:scaleType="centerCrop"
        android:background="#DDDDDD" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvAdminComicTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên truyện tranh"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="15sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvAdminComicAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tác giả: ..."
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvAdminComicStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ongoing"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="8dp">

        <Button
            android:id="@+id/btnAdminEditComic"
            android:layout_width="75dp"
            android:layout_height="34dp"
            android:text="Sửa"
            android:textSize="12sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnAdminDeleteComic"
            android:layout_width="75dp"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:text="Xóa"
            android:textSize="12sp"
            android:backgroundTint="#E74C3C"
            android:textColor="#FFFFFF"
            android:padding="0dp" />
    </LinearLayout>
</LinearLayout>