<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgAdminComicCover"
        android:layout_width="80dp"
        android:layout_height="110dp"
        android:scaleType="centerCrop"
        android:background="#DDDDDD"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvAdminComicTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên Truyện Tranh"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="15sp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvAdminComicLatestChapter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Chương 0"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvAdminComicTimeUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang cập nhật"
                android:textColor="#999999"
                android:textSize="12sp"
                android:textStyle="italic"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvAdminComicViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👁️ 0"
                android:textColor="#666666"
                android:textSize="12sp"/>

            <View android:layout_width="16dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/tvAdminComicLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ 0"
                android:textColor="#666666"
                android:textSize="12sp"/>

            <View android:layout_width="16dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/tvAdminComicComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 0"
                android:textColor="#666666"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnAdminEditComic"
                android:layout_width="70dp"
                android:layout_height="32dp"
                android:text="Sửa"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3498DB"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btnAdminDeleteComic"
                android:layout_width="70dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:text="Xóa"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E74C3C"
                android:padding="0dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>