<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2A2A2A"
        android:orientation="vertical">

        <include
            android:id="@+id/layoutHeaderUserDetail"
            layout="@layout/layout_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E1E1E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBackUserDetail"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Chi tiết người dùng"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminUserDetailBan"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Ban"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:strokeColor="#554336"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp"
                app:icon="@drawable/ic_ban"
                app:iconTint="#FFFFFF"
                app:iconSize="14dp"
                app:iconGravity="textStart"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4D554336" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="64dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#2E3545"
                    app:strokeColor="#0C1322"
                    app:strokeWidth="4dp">

                    <ImageView
                        android:id="@+id/imgAdminUserDetailAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/sym_def_app_icon" />
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnChooseAvatarDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="#33FFB77D"
                    android:text="Chọn ảnh đại diện"
                    android:textColor="#FFB77D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    app:cornerRadius="4dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TÊN NGƯỜI DÙNG"
                            android:textColor="#DBC2B0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/edtDetailName"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="#2A2A2A"
                            android:hint="Nhập tên hiển thị..."
                            android:textColorHint="#6B7280"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:inputType="text"
                            android:singleLine="true"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐỊA CHỈ EMAIL"
                            android:textColor="#DBC2B0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/edtDetailEmail"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="#2A2A2A"
                            android:hint="Nhập email..."
                            android:textColorHint="#6B7280"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VAI TRÒ HỆ THỐNG"
                            android:textColor="#DBC2B0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>
                        <Spinner
                            android:id="@+id/spinnerDetailRole"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="#2A2A2A"
                            android:popupBackground="#2A2A2A"
                            android:theme="@style/ThemeOverlay.AppCompat.Dark"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MẬT KHẨU MỚI (ĐỂ TRỐNG NẾU KHÔNG ĐỔI)"
                            android:textColor="#DBC2B0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#DBC2B0"
                            app:hintEnabled="false">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtDetailPassword"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="#2A2A2A"
                                android:hint="Nhập mật khẩu mới..."
                                android:textColorHint="#6B7280"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:paddingHorizontal="16dp"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#DBC2B0"
                            app:hintEnabled="false">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtDetailConfirmPassword"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:background="#2A2A2A"
                                android:hint="Xác nhận lại mật khẩu mới..."
                                android:textColorHint="#6B7280"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:paddingHorizontal="16dp"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33554336"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvDetailCreatedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ngày tạo tài khoản: dd/MM/yyyy"
                            android:textColor="#A38C7C"
                            android:textSize="13sp"
                            android:textStyle="italic" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="32dp">

                    <Button
                        android:id="@+id/btnAdminUserDetailSave"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="Cập nhật"
                        android:textColor="#432100"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#D97707"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnCancelUserDetail"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:text="Hủy"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@android:color/transparent"
                        app:strokeColor="#554336"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"
                        android:onClick="finishActivity"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#33554336"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"/>

                    <Button
                        android:id="@+id/btnAdminUserDetailDelete"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:text="Xóa tài khoản"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#93000A"
                        app:cornerRadius="12dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/layout_admin_side_menu" />

</androidx.drawerlayout.widget.DrawerLayout>