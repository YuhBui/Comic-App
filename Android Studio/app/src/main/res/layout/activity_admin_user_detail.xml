<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <include android:id="@+id/layoutHeaderUserDetail" layout="@layout/layout_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/imgAdminUserDetailAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@android:drawable/sym_def_app_icon"
                        android:background="#EAEAEA"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tvAdminUserDetailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên Người Dùng"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:id="@+id/tvAdminUserDetailRoleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VAI TRÒ: USER"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:layout_marginTop="6dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvAdminUserDetailId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🆔 Mã ID tài khoản: "
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:padding="8dp"/>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#DDDDDD"/>

                    <TextView
                        android:id="@+id/tvAdminUserDetailEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✉️ Địa chỉ Email: "
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:padding="8dp"/>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#DDDDDD"/>

                    <TextView
                        android:id="@+id/tvAdminUserDetailStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚦 Trạng thái: Active"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnAdminUserDetailBan"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🚷 BAN"
                    android:backgroundTint="#E91E63"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnAdminUserDetailEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="✏️ SỬA"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnAdminUserDetailDelete"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🗑️ XÓA"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>