<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFormTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THÊM TRUYỆN TRANH MỚI"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:textSize="17sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <ImageView
            android:id="@+id/imgComicCoverSelect"
            android:layout_width="75dp"
            android:layout_height="105dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#EAEAEA" />
        <Button
            android:id="@+id/btnSelectCover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn ảnh bìa"
            android:layout_marginStart="16dp"
            android:textSize="12sp"/>
    </LinearLayout>

    <EditText
        android:id="@+id/edtComicTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên truyện tranh"
        android:inputType="text" />

    <EditText
        android:id="@+id/edtComicAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Nhập tên tác giả"
        android:inputType="text" />

    <EditText
        android:id="@+id/edtComicStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Trạng thái (Ongoing / Completed)"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn thể loại truyện:"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:textSize="13sp"/>
    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@android:drawable/btn_dropdown"/>

    <EditText
        android:id="@+id/edtComicDescription"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:hint="Mô tả nội dung truyện..."
        android:gravity="top"
        android:inputType="textMultiLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
            android:id="@+id/btnCancelComicForm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="HỦY BỎ"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnSaveComicForm"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:text="LƯU THÔNG TIN"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>