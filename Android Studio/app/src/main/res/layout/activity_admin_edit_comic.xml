<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#2A2A2A">

        <include
            android:id="@+id/layoutHeaderEditComic"
            layout="@layout/layout_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1E1E1E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:backgroundTint="#1E1E1E">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#FFFFFF"
                android:layout_marginEnd="12dp"
                android:onClick="finishActivity"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tvFormTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thêm truyện mới"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bìa truyện"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="180dp"
                            android:layout_height="240dp"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#2A2A2A">

                            <ImageView
                                android:id="@+id/imgComicCoverSelect"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_gallery"
                                android:contentDescription="Cover Preview"
                                android:alpha="0.8"/>
                        </androidx.cardview.widget.CardView>

                        <Button
                            android:id="@+id/btnSelectCover"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginTop="16dp"
                            android:text="Chọn ảnh bìa"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:backgroundTint="#D97706"
                            android:paddingHorizontal="24dp"
                            app:cornerRadius="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tên truyện"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp"/>
                        <EditText
                            android:id="@+id/edtComicTitle"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="#2A2A2A"
                            android:hint="Nhập tên truyện..."
                            android:textColorHint="#6B7280"
                            android:textColor="#DCE2F7"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:inputType="text"
                            android:singleLine="true"
                            android:layout_marginBottom="20dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tác giả"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp"/>
                        <EditText
                            android:id="@+id/edtComicAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="#2A2A2A"
                            android:hint="Nhập tên tác giả..."
                            android:textColorHint="#6B7280"
                            android:textColor="#DCE2F7"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:inputType="text"
                            android:singleLine="true"
                            android:layout_marginBottom="20dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thể loại"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvComicCategoriesSelect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:text="Bấm vào đây để chọn thể loại..."
                            android:textColor="#A38C7C"
                            android:textSize="14sp"
                            android:background="#2A2A2A"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="20dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trạng thái"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp"/>
                        <RadioGroup
                            android:id="@+id/rgStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="20dp">
                            <RadioButton
                                android:id="@+id/rbOngoing"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:text="Ongoing"
                                android:checked="true"
                                android:textColor="#FFFFFF"
                                android:buttonTint="#FFB77D"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="0dp"
                                android:textSize="14sp"/>
                            <RadioButton
                                android:id="@+id/rbCompleted"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:text="Completed"
                                android:textColor="#FFFFFF"
                                android:buttonTint="#FFB77D"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="0dp"
                                android:textSize="14sp"/>
                        </RadioGroup>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mô tả"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:layout_marginBottom="8dp"/>
                        <EditText
                            android:id="@+id/edtComicDescription"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:hint="Nhập mô tả..."
                            android:textColorHint="#6B7280"
                            android:textColor="#DCE2F7"
                            android:textSize="14sp"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:background="#2A2A2A"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/btnSaveComicForm"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="Cập nhật"
                        android:textColor="#432100"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#D97707"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnCancelComicForm"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="Hủy"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@android:color/transparent"
                        app:strokeColor="#554336"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/layout_admin_side_menu" />

</androidx.drawerlayout.widget.DrawerLayout>