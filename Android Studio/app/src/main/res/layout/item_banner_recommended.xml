<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgBannerCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#2C2C2C"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên Truyện Tranh"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:shadowDx="1"
            android:shadowDy="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBannerChapter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chương 100"
                android:textColor="#D97707"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_eye"
                app:tint="#EEEEEE"/>
            <TextView
                android:id="@+id/tvBannerViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="1.2M"
                android:textColor="#EEEEEE"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"/>

            <ImageView
                android:id="@+id/imgBannerLikesIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="#EEEEEE"/>
            <TextView
                android:id="@+id/tvBannerLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="45K"
                android:textColor="#EEEEEE"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"/>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_comment"
                app:tint="#EEEEEE"/>
            <TextView
                android:id="@+id/tvBannerComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="8K"
                android:textColor="#EEEEEE"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>