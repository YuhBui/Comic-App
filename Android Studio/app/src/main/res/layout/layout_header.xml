<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="#0F0E0E"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/headerMenu"
        android:layout_width="26dp"
        android:layout_height="20dp"
        android:contentDescription="Menu"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#DBC2B0"/>

    <ImageView
        android:id="@+id/headerLogoDecorationImage"
        android:layout_width="51dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Logo trang trí"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_app_logo" />

    <TextView
        android:id="@+id/headerLogo"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="@string/header_logo_html"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"/>

    <EditText
        android:id="@+id/edtHeaderSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:hint="Nhập tên truyện cần tìm..."
        android:textSize="14sp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#80DBC2B0"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:visibility="gone"/>

    <View
        android:id="@+id/headerSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/headerSearch"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Tìm kiếm"
        android:src="@android:drawable/ic_menu_search"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#DBC2B0"/>

    <FrameLayout
        android:id="@+id/layoutNotificationContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/headerNotification"
            android:layout_width="24dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notification"
            android:contentDescription="Notification Icon"
            app:tint="#DBC2B0"/>

        <TextView
            android:id="@+id/tvNotificationBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp"
            android:background="@android:drawable/presence_offline"
            android:backgroundTint="#F44336"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/headerAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Avatar"
        android:src="@android:drawable/sym_def_app_icon"
        android:scaleType="centerCrop"
        android:clickable="true"
        android:focusable="true"
        android:background="#2E3545"
        app:strokeColor="#554336"
        app:shapeAppearanceOverlay="@style/CircleImageView"/>
</LinearLayout>