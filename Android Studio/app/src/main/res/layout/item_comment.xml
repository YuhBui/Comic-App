<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="#2A2A2A"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvUserComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User ID"
                android:textStyle="bold"
                android:textColor="#FFB77D"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvCommentChapterTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="• Chương 1"
                android:textColor="#DBC2B0"
                android:alpha="0.5"
                android:textSize="12sp"
                android:textStyle="italic"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCommentContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nội dung bình luận ở đây..."
        android:textColor="#DBC2B0"
        android:textSize="15sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <LinearLayout
        android:id="@+id/layoutLikeComment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp">
        <ImageView
            android:id="@+id/imgLikeCommentIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_thumb_up_outline"
            app:tint="#DBC2B0"/>
        <TextView
            android:id="@+id/tvLikeCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="(0)"
            android:textColor="#DBC2B0"
            android:textSize="13sp"/>
    </LinearLayout>

        <View android:layout_width="12dp" android:layout_height="1dp"/>

        <LinearLayout
            android:id="@+id/layoutDislikeComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp">
            <ImageView
                android:id="@+id/imgDislikeCommentIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_thumb_down_outline"
                app:tint="#DBC2B0"/>
            <TextView
                android:id="@+id/tvDislikeCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="(0)"
                android:textColor="#DBC2B0"
                android:textSize="13sp"/>
        </LinearLayout>

        <View android:layout_width="12dp" android:layout_height="1dp"/>

        <LinearLayout
            android:id="@+id/layoutReplyComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_comment"
                app:tint="#FFB77D"/>
            <TextView
                android:id="@+id/tvReplyCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#FFB77D"
                android:textStyle="bold"
                android:textSize="13sp"/>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/layoutReportComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp">
            <ImageView
                android:id="@+id/imgReportComment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_report"
                app:tint="#E91E63"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewReplies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvLoadMoreReplies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:text="—— Xem thêm phản hồi ——"
        android:textColor="#FFB77D"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="4dp"
        android:visibility="gone"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="8dp"/>
</LinearLayout>