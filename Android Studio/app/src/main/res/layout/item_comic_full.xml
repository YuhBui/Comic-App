<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgItemCover"
        android:layout_width="80dp"
        android:layout_height="110dp"
        android:scaleType="centerCrop"
        android:background="#DDDDDD"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên Truyện Tranh Siêu Hay"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="15sp"
            android:maxLines="2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvItemLatestChapter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Chương 45"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvItemTimeUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 phút trước"
                android:textColor="#999999"
                android:textSize="12sp"
                android:textStyle="italic"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:textColor="#666666"
            android:textSize="12dp">

            <TextView
                android:id="@+id/tvItemViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👁️ 1.2M"/>

            <View android:layout_width="16dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/tvItemLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ 45K"/>

            <View android:layout_width="16dp" android:layout_height="1dp"/>

            <TextView
                android:id="@+id/tvItemComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 8.9K"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>