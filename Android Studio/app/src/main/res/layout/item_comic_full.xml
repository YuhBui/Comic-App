<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="?android:attr/selectableItemBackground">

    <androidx.cardview.widget.CardView
        android:layout_width="85dp"
        android:layout_height="115dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgItemCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#1E1E1E"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên Truyện Tranh"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItemLatestChapter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Chương 45"
                android:textColor="#D97707"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvItemTimeUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 phút trước"
                android:textColor="#DBC2B0"
                android:textSize="11sp"
                android:textStyle="italic"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutItemStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_eye"
                app:tint="#B2FFFFFF"/>
            <TextView
                android:id="@+id/tvItemViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="1.2M"
                android:textColor="#B2FFFFFF"
                android:textSize="12sp"/>

            <View android:layout_width="16dp" android:layout_height="1dp"/>

            <ImageView
                android:id="@+id/imgItemLikesIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="#B2FFFFFF"/>
            <TextView
                android:id="@+id/tvItemLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="45K"
                android:textColor="#B2FFFFFF"
                android:textSize="12sp"/>

            <View android:layout_width="16dp" android:layout_height="1dp"/>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_comment"
                app:tint="#B2FFFFFF"/>
            <TextView
                android:id="@+id/tvItemComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="8.9K"
                android:textColor="#B2FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>